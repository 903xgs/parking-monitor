# Copy to /opt/parking-monitor/config.env. Never commit the real file.
ACCESS_TOKEN=
BARK_KEY=

# Use the exact queryTempFee URL and request shape already verified in the HAR.
API_URL=
ACCESS_TOKEN_HEADER=access-token
API_METHOD=POST
API_CONTENT_TYPE=application/json;charset=UTF-8
API_BODY_TEMPLATE={"carNo":"{plate}"}
API_TIMEOUT=20

# Put real plates only in the local config.env.
VEHICLES=
# VEHICLES_JSON=[{"plate":"示例车牌","name":"家用车"}]

# Point to the real status field, for example data.isParked.
PARKED_JSON_PATH=
PARKED_TRUE_VALUES=1,true,yes,in,parked,在场,停车中
PARKED_FALSE_VALUES=0,false,no,out,left,离场,未停车
# Use 1 only if non-empty data means the vehicle is parked.
PARKED_WHEN_DATA_NONEMPTY=0

SUCCESS_CODE_JSON_PATH=
SUCCESS_CODE_VALUES=0,200,success
POLL_INTERVAL=60
BARK_SERVER=https://api.day.app
BARK_GROUP=车辆进出提醒
DATA_DIR=/app/data
# API_HEADERS_JSON={"Referer":"https://example.invalid/"}
